{
  "name": "componentlibrary",
  "version": "0.1.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/componentlibrary.cjs",
  "module": "./dist/componentlibrary.js",
  "types": "./dist/types/index.d.ts",
  "style": "./dist/componentlibrary.css",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/componentlibrary.js",
      "require": "./dist/componentlibrary.cjs"
    },
    "./style.css": "./dist/componentlibrary.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.lib.json && node scripts/prepare-package-types.mjs",
    "build:demo": "vite build --mode demo",
    "lint": "oxlint src vite.config.ts",
    "preview": "vite preview --outDir dist-demo",
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^26.1.0",
    "oxlint": "^1.88.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "sass": "^1.89.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.0"
  }
}
